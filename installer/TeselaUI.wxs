<?xml version="1.0" encoding="utf-8"?>
<!--
  Interfaz del instalador de Tesela (WiX Toolset 5.0.2): ventanas propias y minimas, sin WixToolset.UI.wixext y sin una sola
  accion personalizada de codigo. Se compila junto con installer/Tesela.wxs (scripts/build-msi.ps1 pasa los dos archivos a
  `wix build`); Tesela.wxs la enlaza con <UIRef Id="TeselaUI" />. La explicacion de las decisiones (ambito, carpeta,
  propiedades seguras, bloqueo del cambio de ambito) esta en la cabecera de Tesela.wxs.

  Idioma: UN solo MSI. Los textos en INGLES son propiedades normales (tabla Property); si el idioma de usuario de Windows
  (UserLanguageID) es el espanol, una accion de tipo 51 por texto (solo en la secuencia de interfaz) los sustituye por el texto
  en espanol, y los controles muestran la propiedad (`[TxAlgo]`). No hay codigo ni transformaciones. Lo unico que no se puede
  elegir por idioma son las tablas ActionText y UIText (los textos de la barra de progreso): van en los dos idiomas a la vez.
  Para anadir o cambiar un texto hay que tocar TRES sitios: la propiedad en ingles, la accion `TeselaEs_<Id>` y su fila en
  InstallUISequence (las tres siguen el mismo patron y msi-validate.ps1 comprueba que van juntas).

  Estructura: Bienvenida > Ambito > Carpeta y opciones > Listo > Progreso > Fin, mas Mantenimiento (reparar o desinstalar),
  Examinar y las obligatorias (error, cancelacion, fin con error, usuario que sale, archivos en uso, esperar el calculo).
  Las coordenadas de los botones de opcion son relativas al grupo.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- ======================================================================================================== -->
    <!-- Idioma: el de usuario de Windows (UserLanguageID). Espanol en cualquiera de sus variantes; ingles en cualquier otro caso.
         TESELA_LANG=es o TESELA_LANG=en en la linea de comandos lo fuerza (util para probar). -->
    <!-- Propiedades que usan los controles. TESELA_SCOPE (user o machine) es la que muestra el grupo de opciones del ambito:
         por usuario salvo que la accion TeselaScopeMachine la cambie. -->
    <Property Id="TESELA_SCOPE" Value="user" />
    <Property Id="RestartManagerOption" Value="CloseRestart" />
    <CustomAction Id="TeselaLangEs1" Property="TESELA_LANG" Value="es" Execute="immediate" />
    <CustomAction Id="TeselaLangEs2" Property="TESELA_LANG" Value="es" Execute="immediate" />
    <CustomAction Id="TeselaLangEs3" Property="TESELA_LANG" Value="es" Execute="immediate" />
    <CustomAction Id="TeselaLangEn" Property="TESELA_LANG" Value="en" Execute="immediate" />
    <!-- Ambito PREELEGIDO en la ventana de ambito: el de la instalacion existente (para que actualizar sea pulsar Siguiente) o
         el pedido con ALLUSERS=1; si no, por usuario (el valor por defecto de la propiedad). -->
    <CustomAction Id="TeselaScopeMachine" Property="TESELA_SCOPE" Value="machine" Execute="immediate" />

    <InstallUISequence>
      <Custom Action="TeselaScopeMachine" Sequence="1001" Condition='TESELA_SCOPE="user" AND (ALLUSERS=1 OR (TESELA_PREV_MACHINE&lt;&gt;"" AND TESELA_PREV_USER=""))' />
      <!-- Ids de idioma de Windows (LANGID) del espanol: 1034 y 3082 (Espana) y las variantes de America Latina y EE. UU.
           (la condicion admite 255 caracteres: van en tres acciones). -->
      <Custom Action="TeselaLangEs1" Sequence="1003" Condition='TESELA_LANG="" AND (UserLanguageID=1034 OR UserLanguageID=3082 OR UserLanguageID=2058 OR UserLanguageID=4106 OR UserLanguageID=5130 OR UserLanguageID=6154 OR UserLanguageID=7178 OR UserLanguageID=8202)' />
      <Custom Action="TeselaLangEs2" Sequence="1004" Condition='TESELA_LANG="" AND (UserLanguageID=9226 OR UserLanguageID=10250 OR UserLanguageID=11274 OR UserLanguageID=12298 OR UserLanguageID=13322 OR UserLanguageID=14346 OR UserLanguageID=15370 OR UserLanguageID=16394)' />
      <Custom Action="TeselaLangEs3" Sequence="1005" Condition='TESELA_LANG="" AND (UserLanguageID=17418 OR UserLanguageID=18442 OR UserLanguageID=19466 OR UserLanguageID=20490 OR UserLanguageID=21514 OR UserLanguageID=22538 OR UserLanguageID=23562)' />
      <Custom Action="TeselaLangEn" Sequence="1006" Condition='TESELA_LANG=""' />
    </InstallUISequence>

    <!-- Textos en ingles (por defecto: es lo que sale si el idioma de Windows no es el espanol). -->
    <Property Id="TxSetupTitle" Value="Tesela Setup" />
    <Property Id="TxNext" Value="Next &gt;" />
    <Property Id="TxBack" Value="&lt; Back" />
    <Property Id="TxCancel" Value="Cancel" />
    <Property Id="TxInstall" Value="Install" />
    <Property Id="TxFinish" Value="Finish" />
    <Property Id="TxYes" Value="Yes" />
    <Property Id="TxNo" Value="No" />
    <Property Id="TxOk" Value="OK" />
    <Property Id="TxBrowse" Value="Browse..." />
    <Property Id="TxRetry" Value="Retry" />
    <Property Id="TxIgnore" Value="Ignore" />
    <Property Id="TxAbort" Value="Abort" />
    <Property Id="TxRepair" Value="Repair" />
    <Property Id="TxUninstall" Value="Uninstall" />
    <Property Id="TxReturn" Value="Return" />
    <Property Id="TxExitBtn" Value="Exit" />
    <Property Id="TxUp" Value="Up" />
    <Property Id="TxNewFolderBtn" Value="New folder" />
    <Property Id="TxWelcomeTitle" Value="Welcome to the Tesela setup" />
    <Property Id="TxWelcomeBody" Value="This wizard installs Tesela, a visual disk space analyzer and cleaner. You will choose who it is installed for and in which folder." />
    <Property Id="TxWelcomeUpgrade" Value="A version of Tesela is already installed. This setup replaces it. Your settings and cleaning history are kept." />
    <Property Id="TxScopeTitle" Value="Who is Tesela for?" />
    <Property Id="TxScopeUser" Value="Only for me (recommended)" />
    <Property Id="TxScopeUserNote" Value="No administrator permission needed. It is installed in your user profile." />
    <Property Id="TxScopeMachine" Value="For all users of this computer" />
    <Property Id="TxScopeMachineNote" Value="Windows will ask for administrator permission to continue. It is installed in Program Files, so every account on this PC can open Tesela." />
    <Property Id="TxScopeHonest" Value="Installing for all users does NOT give Tesela more permissions to clean. Tesela always runs with normal permissions and refuses to clean if it is started as administrator. This is a safety decision." />
    <Property Id="TxConflictUser" Value="Tesela is already installed only for your user, and Windows cannot change the scope in an update. Uninstall that version first (Settings, Apps, Installed apps) and run this setup again." />
    <Property Id="TxConflictMachine" Value="Tesela is already installed for all users, and Windows cannot change the scope in an update. Uninstall that version first (it needs administrator permission) and run this setup again." />
    <Property Id="TxFolderTitle" Value="Folder and options" />
    <Property Id="TxFolderLabel" Value="Install Tesela in this folder:" />
    <Property Id="TxFolderFixed" Value="Tesela is already installed in this folder, and the update keeps it. To use another folder, uninstall first." />
    <Property Id="TxFolderProtected" Value="This folder is protected by Windows. Installing here needs administrator permission, and this installation is only for you. Choose a folder inside your user profile, or go back and choose the all-users option." />
    <Property Id="TxDesktopCheck" Value="Create a shortcut on the desktop" />
    <Property Id="TxInvalidDirTitle" Value="Invalid folder" />
    <Property Id="TxInvalidDirBody" Value="The folder is not valid, or this installation cannot write to it. Enter the full path of a folder inside your user profile, one that only you can modify (no /, .., ? or network paths)." />
    <Property Id="TxReadyTitle" Value="Ready to install" />
    <Property Id="TxReadyIntro" Value="Check the choices below. Press Install to continue, or Back to change something." />
    <Property Id="TxReadyFolder" Value="Folder:" />
    <Property Id="TxReadyScopeUser" Value="Installed for: only for you." />
    <Property Id="TxReadyScopeMachine" Value="Installed for: all users. Windows will ask for administrator permission to continue." />
    <Property Id="TxReadyDesktop" Value="A shortcut will be created on the desktop." />
    <Property Id="TxMaintTitle" Value="Repair or uninstall Tesela" />
    <Property Id="TxMaintBody" Value="Tesela is already installed. Choose what to do. Uninstalling keeps your settings and cleaning history." />
    <Property Id="TxProgInstalling" Value="Installing Tesela" />
    <Property Id="TxProgRemoving" Value="Uninstalling Tesela" />
    <Property Id="TxProgRepairing" Value="Repairing Tesela" />
    <Property Id="TxProgBody" Value="Please wait. This takes a moment." />
    <Property Id="TxExitInstalled" Value="Tesela is installed" />
    <Property Id="TxExitRemoved" Value="Tesela is uninstalled" />
    <Property Id="TxExitRepaired" Value="Tesela is repaired" />
    <Property Id="TxExitStart" Value="Open Tesela from the Start menu." />
    <Property Id="TxExitPin" Value="To pin Tesela to the taskbar: Start menu, right-click Tesela, Pin to taskbar. Windows does not let installers do this for you." />
    <Property Id="TxExitRemovedBody" Value="Your settings and cleaning history were not deleted." />
    <Property Id="TxFatalTitle" Value="Setup was interrupted" />
    <Property Id="TxFatalBody" Value="Tesela setup ended before it finished. If you saw a permissions error, run the setup again and choose Only for me, or start it as administrator. If it fails again, report it at github.com/wandoth1/tesela/issues" />
    <Property Id="TxUserExitTitle" Value="Setup was cancelled" />
    <Property Id="TxUserExitBody" Value="Tesela setup was cancelled. You can run it again whenever you want." />
    <Property Id="TxCancelBody" Value="Are you sure you want to cancel the Tesela setup?" />
    <Property Id="TxBrowseTitle" Value="Choose folder" />
    <Property Id="TxBrowseLookIn" Value="Look in:" />
    <Property Id="TxBrowseName" Value="Folder name:" />
    <Property Id="TxWaitBody" Value="Please wait while Windows works out the disk space needed." />
    <Property Id="TxFilesTitle" Value="Files in use" />
    <Property Id="TxFilesBody" Value="These applications are using files that setup must update:" />
    <Property Id="TxFilesClose" Value="Close the applications and restart them afterwards." />
    <Property Id="TxFilesNoClose" Value="Do not close them. A restart will be needed to finish." />

    <!-- Textos en espanol: acciones de tipo 51, solo en la secuencia de interfaz y solo si TESELA_LANG=es. -->
    <CustomAction Id="TeselaEs_TxSetupTitle" Property="TxSetupTitle" Value="Instalación de Tesela" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxNext" Property="TxNext" Value="Siguiente &gt;" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxBack" Property="TxBack" Value="&lt; Atrás" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxCancel" Property="TxCancel" Value="Cancelar" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxInstall" Property="TxInstall" Value="Instalar" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxFinish" Property="TxFinish" Value="Finalizar" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxYes" Property="TxYes" Value="Sí" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxNo" Property="TxNo" Value="No" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxOk" Property="TxOk" Value="Aceptar" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxBrowse" Property="TxBrowse" Value="Examinar..." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxRetry" Property="TxRetry" Value="Reintentar" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxIgnore" Property="TxIgnore" Value="Omitir" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxAbort" Property="TxAbort" Value="Anular" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxRepair" Property="TxRepair" Value="Reparar" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxUninstall" Property="TxUninstall" Value="Desinstalar" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxReturn" Property="TxReturn" Value="Volver" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxExitBtn" Property="TxExitBtn" Value="Salir" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxUp" Property="TxUp" Value="Arriba" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxNewFolderBtn" Property="TxNewFolderBtn" Value="Carpeta nueva" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxWelcomeTitle" Property="TxWelcomeTitle" Value="Bienvenido a la instalación de Tesela" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxWelcomeBody" Property="TxWelcomeBody" Value="Este asistente instala Tesela, un analizador y limpiador visual del espacio en disco. Elegirás para quién se instala y en qué carpeta." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxWelcomeUpgrade" Property="TxWelcomeUpgrade" Value="Ya hay una versión de Tesela instalada. Esta instalación la sustituye. Tu configuración y tu historial de limpieza se conservan." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxScopeTitle" Property="TxScopeTitle" Value="¿Para quién es Tesela?" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxScopeUser" Property="TxScopeUser" Value="Solo para mí (recomendado)" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxScopeUserNote" Property="TxScopeUserNote" Value="No hace falta ser administrador. Se instala en tu perfil de usuario." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxScopeMachine" Property="TxScopeMachine" Value="Para todos los usuarios de este equipo" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxScopeMachineNote" Property="TxScopeMachineNote" Value="Windows pedirá permiso de administrador para continuar. Se instala en Archivos de programa y todas las cuentas de este equipo podrán abrir Tesela." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxScopeHonest" Property="TxScopeHonest" Value="Instalar para todos NO da a Tesela más permisos para limpiar. Tesela siempre se ejecuta con permisos normales y se niega a limpiar si se ejecuta como administrador. Es una decisión de seguridad." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxConflictUser" Property="TxConflictUser" Value="Tesela ya está instalada solo para tu usuario y Windows no puede cambiar el ámbito al actualizar. Desinstala antes esa versión (Configuración, Aplicaciones, Aplicaciones instaladas) y vuelve a ejecutar esta instalación." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxConflictMachine" Property="TxConflictMachine" Value="Tesela ya está instalada para todos los usuarios y Windows no puede cambiar el ámbito al actualizar. Desinstala antes esa versión (requiere permiso de administrador) y vuelve a ejecutar esta instalación." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxFolderTitle" Property="TxFolderTitle" Value="Carpeta y opciones" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxFolderLabel" Property="TxFolderLabel" Value="Instalar Tesela en esta carpeta:" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxFolderFixed" Property="TxFolderFixed" Value="Tesela ya está instalada en esta carpeta y la actualización la conserva. Para usar otra, desinstala antes." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxFolderProtected" Property="TxFolderProtected" Value="Esta carpeta está protegida por Windows. Instalar aquí exige permisos de administrador y esta instalación es solo para ti. Elige una carpeta de tu perfil de usuario o vuelve atrás y elige la opción para todos los usuarios." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxDesktopCheck" Property="TxDesktopCheck" Value="Crear un acceso directo en el escritorio" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxInvalidDirTitle" Property="TxInvalidDirTitle" Value="Carpeta no válida" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxInvalidDirBody" Property="TxInvalidDirBody" Value="La carpeta no es válida o esta instalación no puede escribir en ella. Escribe la ruta completa de una carpeta de tu perfil de usuario, que solo tú puedas modificar (sin /, .., ? ni rutas de red)." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxReadyTitle" Property="TxReadyTitle" Value="Listo para instalar" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxReadyIntro" Property="TxReadyIntro" Value="Revisa las opciones. Pulsa Instalar para continuar o Atrás para cambiar algo." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxReadyFolder" Property="TxReadyFolder" Value="Carpeta:" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxReadyScopeUser" Property="TxReadyScopeUser" Value="Instalada para: solo tu usuario." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxReadyScopeMachine" Property="TxReadyScopeMachine" Value="Instalada para: todos los usuarios. Windows pedirá permiso de administrador para continuar." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxReadyDesktop" Property="TxReadyDesktop" Value="Se creará un acceso directo en el escritorio." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxMaintTitle" Property="TxMaintTitle" Value="Reparar o desinstalar Tesela" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxMaintBody" Property="TxMaintBody" Value="Tesela ya está instalada. Elige qué hacer. Desinstalar conserva tu configuración y tu historial de limpieza." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxProgInstalling" Property="TxProgInstalling" Value="Instalando Tesela" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxProgRemoving" Property="TxProgRemoving" Value="Desinstalando Tesela" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxProgRepairing" Property="TxProgRepairing" Value="Reparando Tesela" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxProgBody" Property="TxProgBody" Value="Espera un momento, por favor." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxExitInstalled" Property="TxExitInstalled" Value="Tesela está instalada" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxExitRemoved" Property="TxExitRemoved" Value="Tesela está desinstalada" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxExitRepaired" Property="TxExitRepaired" Value="Tesela está reparada" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxExitStart" Property="TxExitStart" Value="Abre Tesela desde el menú Inicio." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxExitPin" Property="TxExitPin" Value="Para anclar Tesela a la barra de tareas: menú Inicio, clic derecho en Tesela, Anclar a la barra de tareas. Windows no permite que un instalador lo haga por ti." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxExitRemovedBody" Property="TxExitRemovedBody" Value="No se han borrado tu configuración ni tu historial de limpieza." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxFatalTitle" Property="TxFatalTitle" Value="La instalación se interrumpió" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxFatalBody" Property="TxFatalBody" Value="La instalación de Tesela se cerró antes de terminar. Si viste un error de permisos, vuelve a abrirla y elige «Solo para mí», o ejecútala como administrador. Si falla otra vez, cuéntalo en github.com/wandoth1/tesela/issues" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxUserExitTitle" Property="TxUserExitTitle" Value="Instalación cancelada" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxUserExitBody" Property="TxUserExitBody" Value="Se canceló la instalación de Tesela. Puedes volver a ejecutarla cuando quieras." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxCancelBody" Property="TxCancelBody" Value="¿Seguro que quieres cancelar la instalación de Tesela?" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxBrowseTitle" Property="TxBrowseTitle" Value="Elegir carpeta" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxBrowseLookIn" Property="TxBrowseLookIn" Value="Buscar en:" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxBrowseName" Property="TxBrowseName" Value="Nombre de la carpeta:" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxWaitBody" Property="TxWaitBody" Value="Espera mientras Windows calcula el espacio en disco necesario." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxFilesTitle" Property="TxFilesTitle" Value="Archivos en uso" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxFilesBody" Property="TxFilesBody" Value="Estas aplicaciones usan archivos que la instalación debe actualizar:" Execute="immediate" />
    <CustomAction Id="TeselaEs_TxFilesClose" Property="TxFilesClose" Value="Cerrar las aplicaciones y reiniciarlas después." Execute="immediate" />
    <CustomAction Id="TeselaEs_TxFilesNoClose" Property="TxFilesNoClose" Value="No cerrarlas. Hará falta reiniciar el equipo para terminar." Execute="immediate" />

    <InstallUISequence>
      <Custom Action="TeselaEs_TxSetupTitle" Sequence="1011" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxNext" Sequence="1012" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxBack" Sequence="1013" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxCancel" Sequence="1014" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxInstall" Sequence="1015" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxFinish" Sequence="1016" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxYes" Sequence="1017" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxNo" Sequence="1018" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxOk" Sequence="1019" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxBrowse" Sequence="1020" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxRetry" Sequence="1021" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxIgnore" Sequence="1022" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxAbort" Sequence="1023" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxRepair" Sequence="1024" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxUninstall" Sequence="1025" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxReturn" Sequence="1026" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxExitBtn" Sequence="1027" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxUp" Sequence="1028" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxNewFolderBtn" Sequence="1029" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxWelcomeTitle" Sequence="1030" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxWelcomeBody" Sequence="1031" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxWelcomeUpgrade" Sequence="1032" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxScopeTitle" Sequence="1033" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxScopeUser" Sequence="1034" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxScopeUserNote" Sequence="1035" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxScopeMachine" Sequence="1036" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxScopeMachineNote" Sequence="1037" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxScopeHonest" Sequence="1038" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxConflictUser" Sequence="1039" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxConflictMachine" Sequence="1040" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxFolderTitle" Sequence="1041" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxFolderLabel" Sequence="1042" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxFolderFixed" Sequence="1043" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxFolderProtected" Sequence="1044" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxDesktopCheck" Sequence="1045" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxInvalidDirTitle" Sequence="1046" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxInvalidDirBody" Sequence="1047" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxReadyTitle" Sequence="1048" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxReadyIntro" Sequence="1049" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxReadyFolder" Sequence="1050" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxReadyScopeUser" Sequence="1051" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxReadyScopeMachine" Sequence="1052" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxReadyDesktop" Sequence="1053" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxMaintTitle" Sequence="1054" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxMaintBody" Sequence="1055" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxProgInstalling" Sequence="1056" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxProgRemoving" Sequence="1057" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxProgRepairing" Sequence="1058" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxProgBody" Sequence="1059" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxExitInstalled" Sequence="1060" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxExitRemoved" Sequence="1061" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxExitRepaired" Sequence="1062" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxExitStart" Sequence="1063" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxExitPin" Sequence="1064" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxExitRemovedBody" Sequence="1065" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxFatalTitle" Sequence="1066" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxFatalBody" Sequence="1067" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxUserExitTitle" Sequence="1068" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxUserExitBody" Sequence="1069" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxCancelBody" Sequence="1070" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxBrowseTitle" Sequence="1071" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxBrowseLookIn" Sequence="1072" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxBrowseName" Sequence="1073" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxWaitBody" Sequence="1074" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxFilesTitle" Sequence="1075" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxFilesBody" Sequence="1076" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxFilesClose" Sequence="1077" Condition='TESELA_LANG="es"' />
      <Custom Action="TeselaEs_TxFilesNoClose" Sequence="1078" Condition='TESELA_LANG="es"' />
    </InstallUISequence>

    <!-- ======================================================================================================== -->
    <!-- Estilos de texto (sin imagenes ni iconos: no hay tabla Binary). -->
    <Property Id="DefaultUIFont" Value="TeselaFont" />
    <Property Id="ErrorDialog" Value="ErrorDlg" />

    <UI Id="TeselaUI">
    <TextStyle Id="TeselaFont" FaceName="Tahoma" Size="8" />
    <TextStyle Id="TeselaBold" FaceName="Tahoma" Size="8" Bold="yes" />
    <TextStyle Id="TeselaTitle" FaceName="Tahoma" Size="13" Bold="yes" />

    <!-- Texto de la barra de progreso. Los textos de progreso y de error de Windows Installer (ActionText, UIText) son UNA
         sola tabla: no se pueden elegir por idioma sin codigo, asi que van en espanol e ingles a la vez. -->
    <ProgressText Action="InstallInitialize" Message="Preparando / Preparing" />
    <ProgressText Action="RemoveExistingProducts" Message="Quitando la version anterior / Removing the previous version" />
    <ProgressText Action="ProcessComponents" Message="Actualizando componentes / Updating components" />
    <ProgressText Action="InstallFiles" Message="Copiando archivos / Copying files" />
    <ProgressText Action="RemoveFiles" Message="Quitando archivos / Removing files" />
    <ProgressText Action="CreateFolders" Message="Creando carpetas / Creating folders" />
    <ProgressText Action="RemoveFolders" Message="Quitando carpetas / Removing folders" />
    <ProgressText Action="CreateShortcuts" Message="Creando accesos directos / Creating shortcuts" />
    <ProgressText Action="RemoveShortcuts" Message="Quitando accesos directos / Removing shortcuts" />
    <ProgressText Action="WriteRegistryValues" Message="Escribiendo el registro / Writing registry values" />
    <ProgressText Action="RemoveRegistryValues" Message="Limpiando el registro / Cleaning registry values" />
    <ProgressText Action="RegisterProduct" Message="Registrando Tesela / Registering Tesela" />
    <ProgressText Action="PublishProduct" Message="Publicando el producto / Publishing the product" />
    <ProgressText Action="InstallFinalize" Message="Terminando / Finishing" />
    <UIText Id="NewFolder" Value="Folder|New Folder" />

    <!-- ======================================================================================================== -->
    <!-- Ventanas. Solo eventos de control NATIVOS de Windows Installer (SetTargetPath, NewDialog, EndDialog, SpawnDialog,
         Reinstall, Remove...) y propiedades: ni una accion personalizada de codigo. -->

    <!-- 1. Bienvenida -->
    <Dialog Id="WelcomeDlg" Width="370" Height="270" Title="[TxSetupTitle]" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="40" Transparent="yes" NoPrefix="yes" Text="{\TeselaTitle}[TxWelcomeTitle]" />
      <Control Id="Body" Type="Text" X="20" Y="65" Width="330" Height="44" Transparent="yes" NoPrefix="yes" Text="[TxWelcomeBody]" />
      <Control Id="Upgrade" Type="Text" X="20" Y="120" Width="330" Height="33" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\TeselaBold}[TxWelcomeUpgrade]" ShowCondition="WIX_UPGRADE_DETECTED">
      </Control>
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="[TxNext]">
        <Publish Event="NewDialog" Value="ScopeDlg" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[TxCancel]">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
    </Dialog>

    <!-- 2. Ambito. Las coordenadas de los botones de opcion son relativas al grupo. Si el ambito elegido choca con una
         instalacion existente del otro ambito, se muestra el aviso y se desactiva Siguiente (no hace falta ninguna accion). -->
    <Dialog Id="ScopeDlg" Width="370" Height="270" Title="[TxSetupTitle]" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\TeselaTitle}[TxScopeTitle]" />
      <Control Id="ScopeGroup" Type="RadioButtonGroup" X="20" Y="44" Width="330" Height="106" Property="TESELA_SCOPE">
        <RadioButtonGroup Property="TESELA_SCOPE">
          <RadioButton Value="user" X="0" Y="0" Width="330" Height="16" Text="{\TeselaBold}[TxScopeUser]" />
          <RadioButton Value="machine" X="0" Y="50" Width="330" Height="16" Text="{\TeselaBold}[TxScopeMachine]" />
        </RadioButtonGroup>
      </Control>
      <Control Id="UserNote" Type="Text" X="36" Y="62" Width="314" Height="22" Transparent="yes" NoPrefix="yes" Text="[TxScopeUserNote]" />
      <Control Id="MachineNote" Type="Text" X="36" Y="112" Width="314" Height="33" Transparent="yes" NoPrefix="yes" Text="[TxScopeMachineNote]" />
      <Control Id="Honest" Type="Text" X="20" Y="155" Width="330" Height="44" Transparent="yes" NoPrefix="yes" Text="[TxScopeHonest]" />
      <Control Id="ConflictUser" Type="Text" X="20" Y="200" Width="330" Height="33" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\TeselaBold}[TxConflictUser]" ShowCondition="TESELA_SCOPE=&quot;machine&quot; AND TESELA_PREV_USER&lt;&gt;&quot;&quot;">
      </Control>
      <Control Id="ConflictMachine" Type="Text" X="20" Y="200" Width="330" Height="33" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\TeselaBold}[TxConflictMachine]" ShowCondition="TESELA_SCOPE=&quot;user&quot; AND TESELA_PREV_MACHINE&lt;&gt;&quot;&quot; AND TESELA_PREV_USER=&quot;&quot;">
      </Control>
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="[TxBack]">
        <Publish Event="NewDialog" Value="WelcomeDlg" />
      </Control>
      <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="[TxNext]" DisableCondition="(TESELA_SCOPE=&quot;machine&quot; AND TESELA_PREV_USER&lt;&gt;&quot;&quot;) OR (TESELA_SCOPE=&quot;user&quot; AND TESELA_PREV_MACHINE&lt;&gt;&quot;&quot; AND TESELA_PREV_USER=&quot;&quot;)">
        <!-- Contexto: para todos = ALLUSERS=1 y MSIINSTALLPERUSER vacio; solo para mi = ALLUSERS=2 y MSIINSTALLPERUSER=1. -->
        <Publish Property="ALLUSERS" Value="1" Order="1" Condition='TESELA_SCOPE="machine"' />
        <Publish Property="MSIINSTALLPERUSER" Value="{}" Order="2" Condition='TESELA_SCOPE="machine"' />
        <Publish Property="ALLUSERS" Value="2" Order="3" Condition='TESELA_SCOPE="user"' />
        <Publish Property="MSIINSTALLPERUSER" Value="1" Order="4" Condition='TESELA_SCOPE="user"' />
        <!-- Carpeta: la de la instalacion existente de ese ambito; si no hay, la de por defecto del ambito, salvo que la
             carpeta actual sea una personalizada (distinta de las dos de por defecto), que se respeta. -->
        <Publish Property="INSTALLFOLDER" Value="[TESELA_PREV_MACHINE]" Order="5" Condition="TESELA_SCOPE=&quot;machine&quot; AND TESELA_PREV_MACHINE&lt;&gt;&quot;&quot;" />
        <Publish Property="INSTALLFOLDER" Value="[TESELA_PREV_USER]" Order="6" Condition="TESELA_SCOPE=&quot;user&quot; AND TESELA_PREV_USER&lt;&gt;&quot;&quot;" />
        <Publish Property="INSTALLFOLDER" Value="[TESELA_DEFAULT_MACHINE]" Order="7" Condition="TESELA_SCOPE=&quot;machine&quot; AND TESELA_PREV_MACHINE=&quot;&quot; AND (INSTALLFOLDER=&quot;&quot; OR INSTALLFOLDER~=TESELA_DEFAULT_USER)" />
        <Publish Property="INSTALLFOLDER" Value="[TESELA_DEFAULT_USER]" Order="8" Condition="TESELA_SCOPE=&quot;user&quot; AND TESELA_PREV_USER=&quot;&quot; AND (INSTALLFOLDER=&quot;&quot; OR INSTALLFOLDER~=TESELA_DEFAULT_MACHINE)" />
        <Publish Event="NewDialog" Value="FolderDlg" Order="9" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[TxCancel]">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
    </Dialog>

    <!-- 3. Carpeta y opciones. Siguiente: SetTargetPath fija la carpeta; solo se avanza si la ruta parece completa (con unidad o de red) y,
         en "solo para mi", no esta en un sitio protegido (Archivos de programa, Windows); si no, ventana de carpeta no valida. -->
    <Dialog Id="FolderDlg" Width="370" Height="270" Title="[TxSetupTitle]" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\TeselaTitle}[TxFolderTitle]" />
      <Control Id="FolderLabel" Type="Text" X="20" Y="50" Width="330" Height="11" Transparent="yes" NoPrefix="yes" Text="[TxFolderLabel]" />
      <Control Id="FolderEdit" Type="PathEdit" X="20" Y="64" Width="250" Height="18" Property="INSTALLFOLDER" Sunken="yes" DisableCondition="(TESELA_SCOPE=&quot;user&quot; AND TESELA_PREV_USER&lt;&gt;&quot;&quot;) OR (TESELA_SCOPE=&quot;machine&quot; AND TESELA_PREV_MACHINE&lt;&gt;&quot;&quot;)">
      </Control>
      <Control Id="ChangeFolder" Type="PushButton" X="280" Y="63" Width="70" Height="19" Text="[TxBrowse]" DisableCondition="(TESELA_SCOPE=&quot;user&quot; AND TESELA_PREV_USER&lt;&gt;&quot;&quot;) OR (TESELA_SCOPE=&quot;machine&quot; AND TESELA_PREV_MACHINE&lt;&gt;&quot;&quot;)">
        <Publish Property="_BrowseProperty" Value="INSTALLFOLDER" Order="1" />
        <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2" />
      </Control>
      <Control Id="FolderFixed" Type="Text" X="20" Y="88" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[TxFolderFixed]" ShowCondition="(TESELA_SCOPE=&quot;user&quot; AND TESELA_PREV_USER&lt;&gt;&quot;&quot;) OR (TESELA_SCOPE=&quot;machine&quot; AND TESELA_PREV_MACHINE&lt;&gt;&quot;&quot;)">
      </Control>
      <Control Id="FolderProtected" Type="Text" X="20" Y="114" Width="330" Height="44" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\TeselaBold}[TxFolderProtected]" ShowCondition="TESELA_SCOPE=&quot;user&quot; AND (INSTALLFOLDER~&lt;&lt;TESELA_PF64 OR INSTALLFOLDER~&lt;&lt;TESELA_WIN)">
      </Control>
      <Control Id="DesktopShortcut" Type="CheckBox" X="20" Y="170" Width="330" Height="18" Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="[TxDesktopCheck]" />
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="[TxBack]">
        <Publish Event="NewDialog" Value="ScopeDlg" />
      </Control>
      <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="[TxNext]">
        <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="1" />
        <!-- La ruta se da por buena (TESELA_FOLDER_OK=1) si es completa con unidad y sin "/", "..", "?" ni ruta de red; y se
             retira si en "solo para mi" cae en un sitio protegido. Va en dos pasos porque una condicion admite 255 caracteres. -->
        <Publish Property="TESELA_FOLDER_OK" Value="{}" Order="2" />
        <Publish Property="TESELA_FOLDER_OK" Value="1" Order="3" Condition="INSTALLFOLDER&gt;&lt;&quot;:\&quot; AND NOT (INSTALLFOLDER&lt;&lt;&quot;\\&quot; OR INSTALLFOLDER&gt;&lt;&quot;/&quot; OR INSTALLFOLDER&gt;&lt;&quot;..&quot; OR INSTALLFOLDER&gt;&lt;&quot;?&quot;)" />
        <Publish Property="TESELA_FOLDER_OK" Value="{}" Order="4" Condition="TESELA_SCOPE=&quot;user&quot; AND (INSTALLFOLDER~&lt;&lt;TESELA_PF64 OR INSTALLFOLDER~&lt;&lt;TESELA_WIN)" />
        <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="5" Condition="TESELA_FOLDER_OK=1" />
        <Publish Event="SpawnDialog" Value="InvalidDirDlg" Order="6" Condition="NOT TESELA_FOLDER_OK" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[TxCancel]">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
    </Dialog>

    <Dialog Id="InvalidDirDlg" Width="270" Height="105" Title="[TxInvalidDirTitle]" NoMinimize="yes">
      <Control Id="Text" Type="Text" X="15" Y="15" Width="240" Height="55" Transparent="yes" NoPrefix="yes" Text="[TxInvalidDirBody]" />
      <Control Id="OK" Type="PushButton" X="107" Y="80" Width="56" Height="17" Default="yes" Cancel="yes" Text="[TxOk]">
        <Publish Event="EndDialog" Value="Return" />
      </Control>
    </Dialog>

    <!-- Examinar: el dialogo nativo de Windows Installer (PathEdit, DirectoryCombo y DirectoryList sobre _BrowseProperty). -->
    <Dialog Id="BrowseDlg" Width="370" Height="270" Title="[TxBrowseTitle]" NoMinimize="yes">
      <Control Id="ComboLabel" Type="Text" X="25" Y="58" Width="44" Height="10" Transparent="yes" NoPrefix="yes" Text="[TxBrowseLookIn]" />
      <Control Id="DirectoryCombo" Type="DirectoryCombo" X="70" Y="55" Width="185" Height="80" Property="_BrowseProperty" Indirect="yes" Fixed="yes" Remote="yes">
        <Subscribe Event="IgnoreChange" Attribute="IgnoreChange" />
      </Control>
      <Control Id="Up" Type="PushButton" X="260" Y="55" Width="34" Height="19" Text="[TxUp]">
        <Publish Event="DirectoryListUp" Value="0" />
      </Control>
      <Control Id="NewFolder" Type="PushButton" X="298" Y="55" Width="62" Height="19" Text="[TxNewFolderBtn]">
        <Publish Event="DirectoryListNew" Value="0" />
      </Control>
      <Control Id="DirectoryList" Type="DirectoryList" X="25" Y="83" Width="320" Height="98" Property="_BrowseProperty" Indirect="yes" Sunken="yes" TabSkip="no" />
      <Control Id="PathLabel" Type="Text" X="25" Y="190" Width="320" Height="10" Transparent="yes" NoPrefix="yes" Text="[TxBrowseName]" />
      <Control Id="PathEdit" Type="PathEdit" X="25" Y="202" Width="320" Height="18" Property="_BrowseProperty" Indirect="yes" Sunken="yes" />
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="OK" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="[TxOk]">
        <Publish Event="SetTargetPath" Value="[_BrowseProperty]" Order="1" />
        <Publish Event="EndDialog" Value="Return" Order="2" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[TxCancel]">
        <Publish Event="Reset" Value="0" Order="1" />
        <Publish Event="EndDialog" Value="Return" Order="2" />
      </Control>
    </Dialog>

    <!-- 4. Listo para instalar. -->
    <Dialog Id="VerifyReadyDlg" Width="370" Height="270" Title="[TxSetupTitle]" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\TeselaTitle}[TxReadyTitle]" />
      <Control Id="Intro" Type="Text" X="20" Y="48" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Text="[TxReadyIntro]" />
      <Control Id="Folder" Type="Text" X="20" Y="80" Width="330" Height="33" Transparent="yes" NoPrefix="yes" Text="[TxReadyFolder] [INSTALLFOLDER]" />
      <Control Id="ScopeUser" Type="Text" X="20" Y="118" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[TxReadyScopeUser]" ShowCondition="TESELA_SCOPE=&quot;user&quot;">
      </Control>
      <Control Id="ScopeMachine" Type="Text" X="20" Y="118" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[TxReadyScopeMachine]" ShowCondition="TESELA_SCOPE=&quot;machine&quot;">
      </Control>
      <Control Id="Desktop" Type="Text" X="20" Y="145" Width="330" Height="11" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[TxReadyDesktop]" ShowCondition="DESKTOPSHORTCUT=&quot;1&quot;">
      </Control>
      <Control Id="Upgrade" Type="Text" X="20" Y="165" Width="330" Height="33" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[TxWelcomeUpgrade]" ShowCondition="WIX_UPGRADE_DETECTED">
      </Control>
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="[TxBack]">
        <Publish Event="NewDialog" Value="FolderDlg" />
      </Control>
      <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="[TxInstall]" HideCondition="TESELA_SCOPE=&quot;machine&quot;">
        <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Order="1" Condition="CostingComplete=1" />
        <Publish Event="EndDialog" Value="Return" Order="2" />
      </Control>
      <!-- Con "para todos", el boton lleva el escudo de UAC (ElevationShield): Windows pedira administrador. -->
      <Control Id="InstallElevated" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" ElevationShield="yes" Text="[TxInstall]" Hidden="yes" ShowCondition="TESELA_SCOPE=&quot;machine&quot;">
        <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Order="1" Condition="CostingComplete=1" />
        <Publish Event="EndDialog" Value="Return" Order="2" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[TxCancel]">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
    </Dialog>

    <Dialog Id="WaitForCostingDlg" Width="260" Height="85" Title="[TxSetupTitle]" NoMinimize="yes">
      <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="30" Transparent="yes" NoPrefix="yes" Text="[TxWaitBody]" />
      <Control Id="Return" Type="PushButton" X="102" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="[TxReturn]">
        <Publish Event="EndDialog" Value="Exit" />
      </Control>
    </Dialog>

    <!-- Mantenimiento (abrir el MSI de la version ya instalada): reparar o desinstalar. -->
    <Dialog Id="MaintenanceDlg" Width="370" Height="270" Title="[TxSetupTitle]" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\TeselaTitle}[TxMaintTitle]" />
      <Control Id="Body" Type="Text" X="20" Y="48" Width="330" Height="33" Transparent="yes" NoPrefix="yes" Text="[TxMaintBody]" />
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="Repair" Type="PushButton" X="150" Y="243" Width="76" Height="17" Default="yes" Text="[TxRepair]">
        <Publish Event="ReinstallMode" Value="ecmus" Order="1" />
        <Publish Event="Reinstall" Value="All" Order="2" />
        <Publish Event="EndDialog" Value="Return" Order="3" />
      </Control>
      <Control Id="Remove" Type="PushButton" X="228" Y="243" Width="70" Height="17" Text="[TxUninstall]">
        <Publish Event="Remove" Value="All" Order="1" />
        <Publish Event="EndDialog" Value="Return" Order="2" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[TxCancel]">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
    </Dialog>

    <!-- 5. Progreso. -->
    <Dialog Id="ProgressDlg" Width="370" Height="270" Title="[TxSetupTitle]" Modeless="yes" NoMinimize="yes">
      <Control Id="TitleInstalling" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\TeselaTitle}[TxProgInstalling]" ShowCondition="NOT REMOVE AND NOT REINSTALL">
      </Control>
      <Control Id="TitleRemoving" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\TeselaTitle}[TxProgRemoving]" ShowCondition="REMOVE=&quot;ALL&quot;">
      </Control>
      <Control Id="TitleRepairing" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\TeselaTitle}[TxProgRepairing]" ShowCondition="REINSTALL AND NOT REMOVE">
      </Control>
      <Control Id="Body" Type="Text" X="20" Y="48" Width="330" Height="11" Transparent="yes" NoPrefix="yes" Text="[TxProgBody]" />
      <Control Id="ActionText" Type="Text" X="20" Y="100" Width="330" Height="11" Transparent="yes" NoPrefix="yes" Text="Starting...">
        <Subscribe Event="ActionText" Attribute="Text" />
      </Control>
      <Control Id="ActionData" Type="Text" X="20" Y="115" Width="330" Height="11" Transparent="yes" NoPrefix="yes">
        <Subscribe Event="ActionData" Attribute="Text" />
      </Control>
      <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="135" Width="330" Height="10" ProgressBlocks="yes" Text="Progress done">
        <Subscribe Event="SetProgress" Attribute="Progress" />
      </Control>
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="[TxCancel]">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
    </Dialog>

    <!-- 6. Fin. Aqui va la linea de anclar a la barra de tareas: Windows prohibe que un instalador lo haga. -->
    <Dialog Id="ExitDialog" Width="370" Height="270" Title="[TxSetupTitle]" NoMinimize="yes">
      <Control Id="TitleInstalled" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\TeselaTitle}[TxExitInstalled]" ShowCondition="NOT REMOVE AND NOT REINSTALL">
      </Control>
      <Control Id="TitleRemoved" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\TeselaTitle}[TxExitRemoved]" ShowCondition="REMOVE=&quot;ALL&quot;">
      </Control>
      <Control Id="TitleRepaired" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\TeselaTitle}[TxExitRepaired]" ShowCondition="REINSTALL AND NOT REMOVE">
      </Control>
      <Control Id="Start" Type="Text" X="20" Y="55" Width="330" Height="11" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[TxExitStart]" ShowCondition="NOT REMOVE">
      </Control>
      <Control Id="Pin" Type="Text" X="20" Y="80" Width="330" Height="33" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[TxExitPin]" ShowCondition="NOT REMOVE">
      </Control>
      <Control Id="Removed" Type="Text" X="20" Y="55" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="[TxExitRemovedBody]" ShowCondition="REMOVE=&quot;ALL&quot;">
      </Control>
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="[TxFinish]">
        <Publish Event="EndDialog" Value="Return" Order="999" />
      </Control>
    </Dialog>

    <Dialog Id="FatalError" Width="370" Height="270" Title="[TxSetupTitle]" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\TeselaTitle}[TxFatalTitle]" />
      <Control Id="Body" Type="Text" X="20" Y="55" Width="330" Height="55" Transparent="yes" NoPrefix="yes" Text="[TxFatalBody]" />
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="[TxFinish]">
        <Publish Event="EndDialog" Value="Exit" />
      </Control>
    </Dialog>

    <Dialog Id="UserExit" Width="370" Height="270" Title="[TxSetupTitle]" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\TeselaTitle}[TxUserExitTitle]" />
      <Control Id="Body" Type="Text" X="20" Y="55" Width="330" Height="33" Transparent="yes" NoPrefix="yes" Text="[TxUserExitBody]" />
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="[TxFinish]">
        <Publish Event="EndDialog" Value="Exit" />
      </Control>
    </Dialog>

    <Dialog Id="CancelDlg" Width="260" Height="85" Title="[TxSetupTitle]" NoMinimize="yes">
      <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="30" Transparent="yes" NoPrefix="yes" Text="[TxCancelBody]" />
      <Control Id="Yes" Type="PushButton" X="72" Y="57" Width="56" Height="17" Text="[TxYes]">
        <Publish Event="EndDialog" Value="Exit" />
      </Control>
      <Control Id="No" Type="PushButton" X="132" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="[TxNo]">
        <Publish Event="EndDialog" Value="Return" />
      </Control>
    </Dialog>

    <!-- Errores (la propiedad ErrorDialog apunta aqui). El motor rellena ErrorText y coloca solo los botones que hacen falta. -->
    <Dialog Id="ErrorDlg" Width="270" Height="105" Title="[TxSetupTitle]" ErrorDialog="yes" NoMinimize="yes">
      <Control Id="ErrorText" Type="Text" X="15" Y="15" Width="240" Height="60" Transparent="yes" NoPrefix="yes" TabSkip="no" Text="Information text" />
      <Control Id="Y" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="[TxYes]">
        <Publish Event="EndDialog" Value="ErrorYes" />
      </Control>
      <Control Id="A" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="[TxAbort]">
        <Publish Event="EndDialog" Value="ErrorAbort" />
      </Control>
      <Control Id="C" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="[TxCancel]">
        <Publish Event="EndDialog" Value="ErrorCancel" />
      </Control>
      <Control Id="I" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="[TxIgnore]">
        <Publish Event="EndDialog" Value="ErrorIgnore" />
      </Control>
      <Control Id="N" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="[TxNo]">
        <Publish Event="EndDialog" Value="ErrorNo" />
      </Control>
      <Control Id="O" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="[TxOk]">
        <Publish Event="EndDialog" Value="ErrorOk" />
      </Control>
      <Control Id="R" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="[TxRetry]">
        <Publish Event="EndDialog" Value="ErrorRetry" />
      </Control>
    </Dialog>

    <!-- Archivos en uso (Tesela abierta durante una actualizacion): lo usa el Administrador de reinicio (MsiRMFilesInUse) y,
         si no, la ventana clasica (FilesInUse). Sin ellas el motor decide por su cuenta. -->
    <Dialog Id="FilesInUse" Width="370" Height="270" Title="[TxFilesTitle]" KeepModeless="yes" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\TeselaTitle}[TxFilesTitle]" />
      <Control Id="Body" Type="Text" X="20" Y="45" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Text="[TxFilesBody]" />
      <Control Id="List" Type="ListBox" X="20" Y="75" Width="330" Height="130" Property="FileInUseProcess" Sunken="yes" Sorted="yes" />
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="Exit" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[TxExitBtn]">
        <Publish Event="EndDialog" Value="Exit" />
      </Control>
      <Control Id="Ignore" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="[TxIgnore]">
        <Publish Event="EndDialog" Value="Ignore" />
      </Control>
      <Control Id="Retry" Type="PushButton" X="168" Y="243" Width="56" Height="17" Default="yes" Text="[TxRetry]">
        <Publish Event="EndDialog" Value="Retry" />
      </Control>
    </Dialog>

    <Dialog Id="MsiRMFilesInUse" Width="370" Height="270" Title="[TxFilesTitle]" KeepModeless="yes" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="{\TeselaTitle}[TxFilesTitle]" />
      <Control Id="Body" Type="Text" X="20" Y="45" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Text="[TxFilesBody]" />
      <Control Id="List" Type="ListBox" X="20" Y="75" Width="330" Height="100" Property="FileInUseProcess" Sunken="yes" Sorted="yes" />
      <Control Id="RestartGroup" Type="RadioButtonGroup" X="20" Y="185" Width="330" Height="40" Property="RestartManagerOption">
        <RadioButtonGroup Property="RestartManagerOption">
          <RadioButton Value="CloseRestart" X="0" Y="0" Width="330" Height="16" Text="[TxFilesClose]" />
          <RadioButton Value="Restart" X="0" Y="20" Width="330" Height="16" Text="[TxFilesNoClose]" />
        </RadioButtonGroup>
      </Control>
      <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      <Control Id="OK" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="[TxOk]">
        <Publish Event="RMShutdownAndRestart" Value="0" Order="1" Condition='RestartManagerOption="CloseRestart"' />
        <Publish Event="EndDialog" Value="Return" Order="2" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="[TxCancel]">
        <Publish Event="EndDialog" Value="Exit" />
      </Control>
    </Dialog>

    </UI>

    <!-- Secuencia de interfaz: bienvenida (o mantenimiento si ya esta instalada) y progreso; la ventana final y las de
         error y cancelacion salen solas al terminar. Una desinstalacion desde Aplicaciones instaladas (REMOVE=ALL) salta
         directamente al progreso. -->
    <InstallUISequence>
      <Show Dialog="WelcomeDlg" After="MigrateFeatureStates" Condition="NOT Installed" />
      <Show Dialog="MaintenanceDlg" After="MigrateFeatureStates" Condition="Installed AND NOT RESUME AND NOT Preselected AND NOT PATCH" />
      <Show Dialog="ProgressDlg" Before="ExecuteAction" />
      <Show Dialog="ExitDialog" OnExit="success" />
      <Show Dialog="FatalError" OnExit="error" />
      <Show Dialog="UserExit" OnExit="cancel" />
    </InstallUISequence>
    <!-- ICE20 exige las tres tambien en AdminUISequence (instalacion administrativa: msiexec /a, que Tesela no usa). -->
    <AdminUISequence>
      <Show Dialog="ExitDialog" OnExit="success" />
      <Show Dialog="FatalError" OnExit="error" />
      <Show Dialog="UserExit" OnExit="cancel" />
    </AdminUISequence>
  </Fragment>
</Wix>
