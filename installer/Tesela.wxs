<?xml version="1.0" encoding="utf-8"?>
<!--
  Tesela MSI installer (WiX Toolset 5.0.2, MS-RL; a build tool only and not redistributed).
  It is built with scripts/build-msi.ps1, which passes these preprocessor variables and compiles THIS file together with
  installer/TeselaUI.wxs (dialogs and text):
    -d Version=<x.y.z>     product version (from the Cargo workspace; Windows Installer ignores the 4th digit)
    -d SourceDir=<folder>  folder containing EXACTLY the 5 installed files (prepared by the script from the output of
                           scripts/build-release.ps1)
    -d IconFile=<path.ico> icon extracted from tesela.exe with scripts/extract-ico.py

  Decisions (PLAN.md §1 and §3.11, round 14):
    * DUAL SCOPE: "current user only" (default, no administrator access, %LOCALAPPDATA%\Programs\Tesela) or "all users"
      (administrator access required, Program Files\Tesela). This is Windows Installer's standard mechanism for a
      dual-purpose package, declared with Scope="perUserOrMachine" in WiX 5: ALLUSERS=2 and MSIINSTALLPERUSER=1 (per-user
      unless requested otherwise), registry keys in HKMU, and folders resolved by scope. Choosing "all users" does NOT give
      Tesela more permission to clean: Tesela always runs with normal permissions and refuses to clean when run as
      administrator (security decision E1).
    * The package is NOT declared "UAC compliant / no elevation required" (bit 8 of the Summary Information word count): a
      dual-purpose package cannot use that bit. With it set, Windows Installer treats the package as UAC-compatible,
      ignores MSIINSTALLPERUSER, and does not request credentials when "all users" is selected (error 1925). Without it,
      the administrator prompt appears AFTER the UI, when the all-users installation starts, and a per-user installation
      never elevates (the engine has its own branch for this: "dual mode package ... installed in Per-User mode. No
      elevation is required"). WiX 5.0.2 with Scope="perUserOrMachine" does exactly this (word count 2, with neither
      ALLUSERS nor MSIINSTALLPERUSER marked secure). msi-validate.ps1 requires bit 8 clear, ALLUSERS=2, and
      MSIINSTALLPERUSER=1.
    * NO CUSTOM CODE: no DLLs or executables (and no Binary table); WixToolset.UI.wixext is not used (its WixUI_* dialogs
      add custom actions with a DLL). The only custom actions are type 51 (set a property) and type 35 (set a folder);
      msi-validate.ps1 compares them one by one. The UI is in installer/TeselaUI.wxs.
    * No PATH shortcut. The desktop shortcut is OPTIONAL (UI checkbox or DESKTOPSHORTCUT=1 on the command line) and is
      remembered during upgrades.
    * On UNINSTALL, do not delete %APPDATA%\Tesela\config.toml or %LOCALAPPDATA%\Tesela (history and logs): the installer
      does not know about them; they belong to the user (README, "Installation").
    * MajorUpgrade: a new version replaces the previous one (the old version is uninstalled and the new one installed),
      with no duplicates; installing an older version is blocked with a message. If the application is open, Windows
      Installer uses Restart Manager to ask it to close and, if it cannot, leaves files in use to be replaced at restart.
    * SCOPE CHANGE: Windows Installer does not upgrade across contexts (a per-user product cannot be replaced by an
      all-users installation, or vice versa). The previous installation (HKCU\Software\Tesela and HKLM\Software\Tesela,
      already written by v0.1.4) is DETECTED and a scope change is BLOCKED with a message saying to uninstall first.
      Blocking is preferred to silently "fixing" the scope: in silent mode (/qn) there is no one to explain it to and
      silently fixing it would change the command-line request; in the UI, the scope dialog PRESELECTS the existing
      installation's scope (so upgrading means pressing Next) and warns if the other scope is selected.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    UpgradeCode: identifies Tesela as a PRODUCT forever. NEVER CHANGE IT: with a different value, a new version would not
    recognize the previous one and both would remain installed. ProductCode, by contrast, is new on every build
    (Id="*" by default), as required by MajorUpgrade.
  -->
  <Package
    Name="Tesela"
    Manufacturer="Tesela contributors"
    Version="$(Version)"
    UpgradeCode="7E8F4B67-A7D4-415B-9F8F-2E0B88AA88BB"
    Scope="perUserOrMachine"
    Language="1033"
    Compressed="yes">

    <SummaryInformation
      Description="Tesela - visual disk space analyzer and cleaner / Analizador visual de espacio en disco"
      Manufacturer="Tesela contributors" />

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="Ya hay instalada una version mas reciente de Tesela. Desinstalala antes si quieres volver a esta. / A newer version of Tesela is already installed. Uninstall it first if you want to go back to this one." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icon for Installed apps and the shortcut: the SAME one embedded in tesela.exe, extracted from the compiled
         executable (scripts/extract-ico.py). Pointing the Icon table at the .exe would embed a complete copy of it. -->
    <Icon Id="TeselaIcon.ico" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="TeselaIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/wandoth1/tesela" />
    <Property Id="ARPHELPLINK" Value="https://github.com/wandoth1/tesela/issues" />
    <!-- There is nothing to "modify": only repair or uninstall. -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <!--
      Scope: Scope="perUserOrMachine" above sets ALLUSERS=2 and MSIINSTALLPERUSER=1 (per-user unless requested otherwise).
      `ALLUSERS=1` on the command line (or the scope dialog) selects all users. Neither is marked Secure by design: ALLUSERS
      is one of the properties Windows Installer ALWAYS passes to the server (the "restricted public properties" list),
      and MSIINSTALLPERUSER is read only with ALLUSERS=2; for "all users," the UI sets ALLUSERS=1. Therefore the only
      documented way to request "all users" without the UI is ALLUSERS=1.
    -->

    <!--
      SECURE PROPERTIES (reverses v0.1.4 decision R-S3, which left INSTALLFOLDER unsecured).
      Previously there was no UI and the package was per-user and non-elevated, so there was nothing to pass to the server.
      Now the UI (or command line) sets INSTALLFOLDER and DESKTOPSHORTCUT in the UI phase; in an elevated ALL-USERS install,
      they reach the server only if secure. Without Secure, "all users" would silently ignore the selected folder and
      shortcut and use the defaults.
      RISK with the AlwaysInstallElevated policy (HKLM and HKCU, disabled by default in Windows): any user can install ANY
      .msi with SYSTEM permissions (a known privilege escalation from that policy, not this package), and Secure also lets
      the user choose the folder where the server writes. This is ACCEPTED because it adds nothing new: (1) the MSI fixes
      the contents (5 Tesela files; the user cannot change them), (2) with that policy the user could already install their
      own MSI as SYSTEM, (3) RemoveFolder removes only EMPTY folders, and (4) the folder is compared with a protected-location
      list only to display a warning, not as a guard. Anyone with that policy enabled already has a larger problem than this
      installer. Without Secure, the UI's all-users installation would not work; the alternative (a custom action that
      rereads the value) is prohibited by the no-custom-code rule. msi-validate.ps1 requires exactly these two (and the
      MajorUpgrade properties) in SecureCustomProperties.
    -->
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />

    <!--
      Previous installations (used to detect scope conflicts and choose the folder during upgrades). Values are written by
      the components themselves (InstallFolder and DesktopShortcut, in HKMU: HKCU for per-user installs, HKLM for all-users
      installs). These are registry searches (AppSearch, also in the server sequence), with no custom action. Both roots
      are searched deliberately: AppSearch runs BEFORE the UI selects a scope, so it cannot use HKMU. v0.1.4 already wrote
      HKCU\Software\Tesela\InstallFolder; it is recognized and upgraded in place.
    -->
    <Property Id="TESELA_PREV_USER">
      <RegistrySearch Id="PrevUserFolder" Root="HKCU" Key="Software\Tesela" Name="InstallFolder" Type="raw" />
    </Property>
    <Property Id="TESELA_PREV_MACHINE">
      <RegistrySearch Id="PrevMachineFolder" Root="HKLM" Key="Software\Tesela" Name="InstallFolder" Type="raw" />
    </Property>
    <Property Id="TESELA_PREV_DESKTOP_USER">
      <RegistrySearch Id="PrevUserDesktop" Root="HKCU" Key="Software\Tesela" Name="DesktopShortcut" Type="raw" />
    </Property>
    <Property Id="TESELA_PREV_DESKTOP_MACHINE">
      <RegistrySearch Id="PrevMachineDesktop" Root="HKLM" Key="Software\Tesela" Name="DesktopShortcut" Type="raw" />
    </Property>
    <!--
       A remembered folder WITHOUT tesela.exe does not count (for example, a folder deleted without uninstalling).
       This checks file existence, NOT Windows Installer product registration. A registry value plus an orphaned executable
       still counts; see the installer README recovery procedure before changing orphaned metadata. This is another registry
      search with a FileSearch, with no code; AppSearch processes them in alphabetical property order, and _EXE follows its
      folder property. If the file is missing, the TeselaStale* actions below clear TESELA_PREV_USER / TESELA_PREV_MACHINE
      and the key is ignored (it does not block a scope change or select a folder that no longer exists).
    -->
    <Property Id="TESELA_PREV_USER_EXE">
      <RegistrySearch Id="PrevUserExe" Root="HKCU" Key="Software\Tesela" Name="InstallFolder" Type="directory">
        <FileSearch Name="tesela.exe" />
      </RegistrySearch>
    </Property>
    <Property Id="TESELA_PREV_MACHINE_EXE">
      <RegistrySearch Id="PrevMachineExe" Root="HKLM" Key="Software\Tesela" Name="InstallFolder" Type="directory">
        <FileSearch Name="tesela.exe" />
      </RegistrySearch>
    </Property>

    <!--
      Directory tree. INSTALLFOLDER is under TARGETDIR and its REAL path is set by the type 51 actions below (the
      INSTALLFOLDER property, which Windows Installer uses as the Directory path when calculating costs), according to
      scope: [LocalAppDataFolder]Programs\Tesela\ (per-user), %ProgramW6432%\Tesela\ (all-users), the previous install's
      folder, or the value passed as INSTALLFOLDER= / selected in the dialog. "Tesela" is the name only when nothing sets
      it. (Type 51 is used instead of 35 because ICE12 requires type 35 AFTER CostFinalize, but the folder must be set
      BEFORE then.) ProgramMenuFolder and DesktopFolder depend on ALLUSERS (the user's or computer-wide menu and desktop).
    -->
    <Directory Id="INSTALLFOLDER" Name="Tesela" />
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Installation folder: use the previous installation's folder for that scope (an upgrade stays where it was; the
         command line does NOT change it, as in v0.1.4: uninstall and reinstall to move it), or the default folder if
         nothing sets it. Run in BOTH sequences (UI and server): because these actions are idempotent, the server repeats
         the calculation for an all-users install with the secure value it receives and does not change it. -->
    <!-- NOTE: in per-user context (the initial state: MSIINSTALLPERUSER=1), Windows Installer REDIRECTS [ProgramFilesFolder]
         and [ProgramFiles64Folder] to %LOCALAPPDATA%\Programs\ (verified with a session of this package). Therefore the
         all-users folder and protected folders do NOT come from those properties, but from system environment variables
         (%ProgramW6432%, %SystemRoot%), which do not depend on context.
         Protected folders are compared by PREFIX and WITHOUT a trailing slash (`C:\Program Files`, `C:\WINDOWS`), covering
         `C:\Program Files`, `C:\Program Files\X`, `C:\Program Files (x86)\X`, and `C:\Program Files (Arm)\X` (ARM64),
         case-insensitively. Accepted tradeoff: a folder whose NAME begins the same way (`C:\Program Files2`,
         `C:\Windows.old`) is also treated as protected. This is a warning, not a guard (see README). -->
    <CustomAction Id="TeselaStaleUser" Property="TESELA_PREV_USER" Value="" Execute="immediate" />
    <CustomAction Id="TeselaStaleMachine" Property="TESELA_PREV_MACHINE" Value="" Execute="immediate" />
    <CustomAction Id="TeselaSetDefaultUser" Property="TESELA_DEFAULT_USER" Value="[LocalAppDataFolder]Programs\Tesela\" Execute="immediate" />
    <CustomAction Id="TeselaSetDefaultMachine" Property="TESELA_DEFAULT_MACHINE" Value="[%ProgramW6432]\Tesela\" Execute="immediate" />
    <CustomAction Id="TeselaSetProtected64" Property="TESELA_PF64" Value="[%ProgramW6432]" Execute="immediate" />
    <CustomAction Id="TeselaSetProtectedWin" Property="TESELA_WIN" Value="[%SystemRoot]" Execute="immediate" />
    <CustomAction Id="TeselaFolderPrevUser" Property="INSTALLFOLDER" Value="[TESELA_PREV_USER]" Execute="immediate" />
    <CustomAction Id="TeselaFolderPrevMachine" Property="INSTALLFOLDER" Value="[TESELA_PREV_MACHINE]" Execute="immediate" />
    <CustomAction Id="TeselaFolderDefaultUser" Property="INSTALLFOLDER" Value="[TESELA_DEFAULT_USER]" Execute="immediate" />
    <CustomAction Id="TeselaFolderDefaultMachine" Property="INSTALLFOLDER" Value="[TESELA_DEFAULT_MACHINE]" Execute="immediate" />
    <!-- Desktop shortcut: remembered. If DESKTOPSHORTCUT is not set (empty) and the previous installation had one (and it
         exists: tesela.exe is in its folder), keep it. An explicit value (DESKTOPSHORTCUT=0 or the UI checkbox) takes
         precedence. Only in the server sequence when there is NO full UI (UILevel < 5): with the UI, the checkbox already
         starts from the remembered value, and the server must NOT set it again if the user cleared it. -->
    <CustomAction Id="TeselaRememberDesktop" Property="DESKTOPSHORTCUT" Value="1" Execute="immediate" />

    <!-- When these actions run (after AppSearch fills TESELA_PREV_*, and before LaunchConditions and CostInitialize).
         First discard keys with no product. -->
    <InstallUISequence>
      <Custom Action="TeselaStaleUser" Sequence="51" Condition="TESELA_PREV_USER&lt;&gt;&quot;&quot; AND TESELA_PREV_USER_EXE=&quot;&quot;" />
      <Custom Action="TeselaStaleMachine" Sequence="52" Condition="TESELA_PREV_MACHINE&lt;&gt;&quot;&quot; AND TESELA_PREV_MACHINE_EXE=&quot;&quot;" />
      <Custom Action="TeselaSetDefaultUser" Sequence="53" />
      <Custom Action="TeselaSetDefaultMachine" Sequence="54" />
      <Custom Action="TeselaSetProtected64" Sequence="55" />
      <Custom Action="TeselaSetProtectedWin" Sequence="56" />
      <Custom Action="TeselaFolderPrevUser" Sequence="57" Condition="TESELA_PREV_USER&lt;&gt;&quot;&quot; AND NOT (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderPrevMachine" Sequence="58" Condition="TESELA_PREV_MACHINE&lt;&gt;&quot;&quot; AND (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderDefaultUser" Sequence="59" Condition="INSTALLFOLDER=&quot;&quot; AND NOT (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderDefaultMachine" Sequence="60" Condition="INSTALLFOLDER=&quot;&quot; AND (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaRememberDesktop" Sequence="61" Condition="DESKTOPSHORTCUT=&quot;&quot; AND ((TESELA_PREV_DESKTOP_USER=&quot;1&quot; AND TESELA_PREV_USER&lt;&gt;&quot;&quot;) OR (TESELA_PREV_DESKTOP_MACHINE=&quot;1&quot; AND TESELA_PREV_MACHINE&lt;&gt;&quot;&quot;))" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="TeselaStaleUser" Sequence="51" Condition="TESELA_PREV_USER&lt;&gt;&quot;&quot; AND TESELA_PREV_USER_EXE=&quot;&quot;" />
      <Custom Action="TeselaStaleMachine" Sequence="52" Condition="TESELA_PREV_MACHINE&lt;&gt;&quot;&quot; AND TESELA_PREV_MACHINE_EXE=&quot;&quot;" />
      <Custom Action="TeselaSetDefaultUser" Sequence="53" />
      <Custom Action="TeselaSetDefaultMachine" Sequence="54" />
      <Custom Action="TeselaSetProtected64" Sequence="55" />
      <Custom Action="TeselaSetProtectedWin" Sequence="56" />
      <Custom Action="TeselaFolderPrevUser" Sequence="57" Condition="TESELA_PREV_USER&lt;&gt;&quot;&quot; AND NOT (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderPrevMachine" Sequence="58" Condition="TESELA_PREV_MACHINE&lt;&gt;&quot;&quot; AND (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderDefaultUser" Sequence="59" Condition="INSTALLFOLDER=&quot;&quot; AND NOT (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderDefaultMachine" Sequence="60" Condition="INSTALLFOLDER=&quot;&quot; AND (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaRememberDesktop" Sequence="61" Condition="UILevel&lt;5 AND DESKTOPSHORTCUT=&quot;&quot; AND ((TESELA_PREV_DESKTOP_USER=&quot;1&quot; AND TESELA_PREV_USER&lt;&gt;&quot;&quot;) OR (TESELA_PREV_DESKTOP_MACHINE=&quot;1&quot; AND TESELA_PREV_MACHINE&lt;&gt;&quot;&quot;))" />
    </InstallExecuteSequence>

    <!--
      Launch conditions (in addition to the downgrade condition added by MajorUpgrade). They always allow repair or
      uninstall (Installed) and EVERY install with full UI (UILevel 5): with the UI, the dialogs themselves warn and block
      continuation (scope and folder dialogs), and these conditions are evaluated BEFORE the user makes a choice. Without
      UI (/qn, /qb), there is no one to warn, so these conditions apply.
      "All-users installation" = ALLUSERS=1, or ALLUSERS=2 with MSIINSTALLPERUSER empty.
      * Scope change: per-user to all-users is always blocked when THIS user has a per-user install. All-users to per-user
        is blocked only if THIS user does not already have a per-user install: theirs takes precedence and can be upgraded
        even if another account installed for all users.
      * A protected folder (Program Files, Windows) is rejected for "current user only" for ANY user, including
        administrators: do not use Privileged (Windows Installer docs say it has the same value as AdminUser: the USER is
        an administrator, not that the process is elevated; an unelevated administrator also cannot write to Program Files).
        Also, choosing Program Files for "current user only" is a user error: "all users" is the right choice.
      * Path format: must be an absolute drive path (C:\...) without "/", "..", "?", or a network path (\\). Otherwise the
        protected-folder warning could be bypassed with `C:/Program Files/X`, `C:\x\..\Program Files`, `?\C:\...` using a
        long-path prefix, or a network administrative share (C$). 8.3 short names (`C:\PROGRA~1`) are NOT detected without
        code; this is a warning, not a guard.
      Messages are bilingual (Spanish and English together); choosing a language here without custom actions is not possible.
    -->
    <Launch
      Condition="Installed OR UILevel&gt;=5 OR NOT (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER)) OR TESELA_PREV_USER=&quot;&quot;"
      Message="Tesela ya está instalada solo para tu usuario: desinstálala antes de instalarla para todos los usuarios. / Tesela is already installed for your user only: uninstall it before installing it for all users." />
    <Launch
      Condition="Installed OR UILevel&gt;=5 OR (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER)) OR TESELA_PREV_MACHINE=&quot;&quot; OR TESELA_PREV_USER&lt;&gt;&quot;&quot;"
      Message="Tesela ya está instalada para todos los usuarios: actualízala con ALLUSERS=1 o desinstálala antes de cambiar de ámbito. / Tesela is already installed for all users: update it with ALLUSERS=1 or uninstall it before changing scope." />
    <Launch
      Condition="Installed OR UILevel&gt;=5 OR ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER) OR NOT (INSTALLFOLDER~&lt;&lt;TESELA_PF64 OR INSTALLFOLDER~&lt;&lt;TESELA_WIN)"
      Message="INSTALLFOLDER está en un sitio protegido y esta instalación es solo para tu usuario: elige otra carpeta o usa ALLUSERS=1. / INSTALLFOLDER is in a protected location and this install is for your user only: choose another folder or use ALLUSERS=1." />
    <Launch
      Condition="Installed OR UILevel&gt;=5 OR (INSTALLFOLDER&gt;&lt;&quot;:\&quot; AND NOT (INSTALLFOLDER&lt;&lt;&quot;\\&quot; OR INSTALLFOLDER&gt;&lt;&quot;/&quot; OR INSTALLFOLDER&gt;&lt;&quot;..&quot; OR INSTALLFOLDER&gt;&lt;&quot;?&quot;))"
      Message="INSTALLFOLDER tiene que ser una ruta completa con unidad (C:\Carpeta), sin /, .., ? ni ruta de red. / INSTALLFOLDER must be a full path with a drive letter (C:\Folder), without /, .., ? or a network path." />

    <!--
      One component per file. Each component uses an HKMU value as its KeyPath (HKCU for per-user installs, HKLM for
      all-users): this avoids ICE38 (profile files cannot be their own KeyPath) and mixing per-user and per-machine data
      (ICE57); Windows Installer removes these values on uninstall. With both a file AND a registry value, WiX cannot
      generate the component GUID, so they are FIXED (do not change them: Windows Installer identifies a component across
      versions by its GUID; these are the same as in v0.1.4).
    -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="TeselaExe" Guid="B684DA7F-4E1F-49DD-9ED7-A7D2C72A1B22">
        <File Id="TeselaExe" Source="$(SourceDir)\tesela.exe" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="tesela.exe" Type="integer" Value="1" KeyPath="yes" />
        <!-- The folder is REMEMBERED here and retrieved by the registry search above (during upgrades, repairs, and
             uninstall): without it, uninstalling or upgrading without repeating INSTALLFOLDER would make Windows
             Installer look for the default folder and leave custom-folder files behind. -->
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" />
        <!-- Remove the folder ONLY if empty (preserve anything the user left inside). The parent folder (Programs or
             another folder) is untouched: it is no longer under a known profile folder. -->
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
      <Component Id="TeselaScanExe" Guid="F6AC4BAC-3E83-4784-ACA7-50ED49A1D3D9">
        <File Id="TeselaScanExe" Source="$(SourceDir)\tesela-scan.exe" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="tesela-scan.exe" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="LicenseMit" Guid="1B50C86F-50F5-4EEF-B97B-BE62D82BBB9D">
        <File Id="LicenseMit" Source="$(SourceDir)\LICENSE-MIT" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="LICENSE-MIT" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="LicenseApache" Guid="100B9CE0-2501-4884-8A2D-FE074CF71F06">
        <File Id="LicenseApache" Source="$(SourceDir)\LICENSE-APACHE" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="LICENSE-APACHE" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyNotices" Guid="0FFBF222-BD3C-4B09-A7A1-97CA3D105F13">
        <File Id="ThirdPartyNotices" Source="$(SourceDir)\THIRD-PARTY-NOTICES.md" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="THIRD-PARTY-NOTICES.md" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Start menu shortcut (directly under Programs, with no separate folder): the user's or computer-wide shortcut,
         depending on scope. FIXED GUID like the other components (do not change it). -->
    <ComponentGroup Id="StartMenu" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="089416B7-8B88-4F2D-9636-96931BE9FCC0">
        <Shortcut
          Id="StartMenuShortcut"
          Name="Tesela"
          Description="Visual disk space analyzer and cleaner"
          Target="[INSTALLFOLDER]tesela.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="TeselaIcon.ico" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Desktop shortcut (OPTIONAL, unchecked by default: UI checkbox or DESKTOPSHORTCUT=1). The DesktopShortcut="1"
         registry value is its KeyPath AND the marker searched by TESELA_PREV_DESKTOP_*: this remembers it during upgrades
         (the new installer finds it and recreates it) and removes it with the component on uninstall. -->
    <ComponentGroup Id="DesktopShortcutGroup" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="5C2D6C0B-7C3E-4B6B-9B7A-3E0D1A9F6D41" Condition="DESKTOPSHORTCUT=&quot;1&quot;">
        <Shortcut
          Id="DesktopShortcut"
          Name="Tesela"
          Description="Visual disk space analyzer and cleaner"
          Target="[INSTALLFOLDER]tesela.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="TeselaIcon.ico" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="DesktopShortcut" Type="string" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Tesela" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="StartMenu" />
      <ComponentGroupRef Id="DesktopShortcutGroup" />
    </Feature>

    <UIRef Id="TeselaUI" />
  </Package>
</Wix>
