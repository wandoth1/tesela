<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador MSI de Tesela (WiX Toolset 5.0.2, MS-RL; solo es una herramienta de compilacion, no se redistribuye).
  Se compila con scripts/build-msi.ps1, que pasa estas variables del preprocesador y compila ESTE archivo junto con
  installer/TeselaUI.wxs (las ventanas y los textos):
    -d Version=<x.y.z>    version del producto (sale del workspace de Cargo; la 4a cifra la ignora Windows Installer)
    -d SourceDir=<carpeta> carpeta con EXACTAMENTE los 5 archivos que se instalan (la prepara el script a partir de lo que
                          produce scripts/build-release.ps1)
    -d IconFile=<ruta.ico> icono extraido de tesela.exe con scripts/extract-ico.py

  Decisiones (PLAN.md §1 y §3.11, ronda 14):
    * AMBITO DUAL: "solo para mi" (por defecto, sin administrador, %LOCALAPPDATA%\Programs\Tesela) o "para todos los usuarios"
      (pide administrador, Program Files\Tesela). Es el mecanismo estandar de Windows Installer para un paquete de doble
      proposito, el que declara Scope="perUserOrMachine" en WiX 5: ALLUSERS=2 y MSIINSTALLPERUSER=1 (por usuario salvo que se
      pida otra cosa), claves de registro en HKMU y carpetas calculadas por ambito. Elegir "para todos" NO da a Tesela mas
      permisos para limpiar: Tesela siempre corre con permisos normales y se niega a limpiar si se ejecuta como administrador
      (decision de seguridad E1).
    * El paquete NO se declara "compatible con UAC / no hace falta elevar" (bit 8 del contador de palabras del Summary Information):
      un paquete de doble modo no puede llevarlo. Con el bit, Windows Installer trata el paquete como UAC-compatible, ignora
      MSIINSTALLPERUSER y no pide credenciales al elegir "para todos" (error 1925). Sin el, la peticion de administrador sale
      DESPUES de la interfaz, al empezar la instalacion para todos, y la instalacion por usuario no eleva nunca (el motor tiene
      su propia rama para eso: "dual mode package ... installed in Per-User mode. No elevation is required"). WiX 5.0.2 con
      Scope="perUserOrMachine" da exactamente eso (contador de palabras 2, sin ALLUSERS/MSIINSTALLPERUSER marcadas como seguras).
      msi-validate.ps1 exige: bit 8 limpio, ALLUSERS=2 y MSIINSTALLPERUSER=1.
    * SIN CODIGO PROPIO: no hay DLL ni ejecutables (ni tabla Binary), no se usa WixToolset.UI.wixext (sus ventanas WixUI_*
      meten acciones personalizadas con DLL). Las unicas acciones personalizadas son de tipo 51 (fijan una propiedad) y de
      tipo 35 (fijan una carpeta); msi-validate.ps1 las compara una a una. La interfaz esta en installer/TeselaUI.wxs.
    * Sin acceso en el PATH. El acceso directo del escritorio es OPCIONAL (casilla de la interfaz o DESKTOPSHORTCUT=1 en la
      linea de comandos) y se recuerda en las actualizaciones.
    * Al DESINSTALAR no se borran %APPDATA%\Tesela\config.toml ni %LOCALAPPDATA%\Tesela (historial y registros): el
      instalador no los conoce, son del usuario (README, "Instalacion").
    * MajorUpgrade: una version nueva sustituye a la anterior (se desinstala la vieja y se instala la nueva) sin
      duplicados; instalar una anterior se bloquea con un mensaje. Con la aplicacion abierta, Windows Installer usa el
      Administrador de reinicio (Restart Manager) para pedirle que se cierre y, si no puede, deja los archivos en uso
      para sustituirlos al reiniciar.
    * CAMBIO DE AMBITO: Windows Installer no actualiza entre contextos (un producto por usuario no se sustituye desde una
      instalacion para todos, ni al reves). Se DETECTA la instalacion previa (HKCU\Software\Tesela y HKLM\Software\Tesela,
      que ya escribia la v0.1.4) y se BLOQUEA el cambio con un mensaje que dice que hay que desinstalar antes. Se prefiere
      bloquear a "fijar" el ambito: sin interfaz (/qn) no hay a quien explicarselo y fijarlo en silencio cambiaria lo que
      pide la linea de comandos; con interfaz, la ventana de ambito PREELIGE el de la instalacion existente (asi actualizar
      es pulsar Siguiente) y avisa si se elige el otro.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    UpgradeCode: identifica a Tesela como PRODUCTO para siempre. NO CAMBIARLO NUNCA: con otro valor, una version nueva no
    reconoceria a la anterior y las dos quedarian instaladas a la vez. El ProductCode, en cambio, es nuevo en cada
    compilacion (Id="*" por defecto), como exige MajorUpgrade.
  -->
  <Package
    Name="Tesela"
    Manufacturer="Tesela contributors"
    Version="$(Version)"
    UpgradeCode="7E8F4B67-A7D4-415B-9F8F-2E0B88AA88BB"
    Scope="perUserOrMachine"
    Language="1033"
    Compressed="yes">

    <SummaryInformation
      Description="Tesela - visual disk space analyzer and cleaner / Analizador visual de espacio en disco"
      Manufacturer="Tesela contributors" />

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="Ya hay instalada una version mas reciente de Tesela. Desinstalala antes si quieres volver a esta. / A newer version of Tesela is already installed. Uninstall it first if you want to go back to this one." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icono de Aplicaciones instaladas y del acceso directo: el MISMO que lleva tesela.exe, extraido del ejecutable ya
         compilado (scripts/extract-ico.py). Apuntar la tabla Icon al .exe incrustaria una copia entera de el. -->
    <Icon Id="TeselaIcon.ico" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="TeselaIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/wandoth1/tesela" />
    <Property Id="ARPHELPLINK" Value="https://github.com/wandoth1/tesela/issues" />
    <!-- No hay nada que "modificar": solo reparar o desinstalar. -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <!--
      Ambito: Scope="perUserOrMachine" de arriba define ALLUSERS=2 y MSIINSTALLPERUSER=1 (por usuario salvo que se pida otra
      cosa). `ALLUSERS=1` en la linea de comandos (o la ventana de ambito) da la instalacion para todos. Ninguna de las dos es
      Secure a proposito: ALLUSERS es de las propiedades que Windows Installer pasa SIEMPRE al servidor (lista de "propiedades
      publicas restringidas"), y MSIINSTALLPERUSER solo se lee con ALLUSERS=2; para "para todos" la interfaz fija ALLUSERS=1.
      Por eso la unica forma documentada de pedir "para todos" sin interfaz es ALLUSERS=1.
    -->

    <!--
      PROPIEDADES SEGURAS (revierte la decision R-S3 de la v0.1.4, que dejaba INSTALLFOLDER sin Secure).
      Antes no habia interfaz y el paquete era solo por usuario y sin elevar, asi que no habia nada que traspasar al servidor.
      Ahora la interfaz (o la linea de comandos) fija INSTALLFOLDER y DESKTOPSHORTCUT en la fase de interfaz y, en una
      instalacion PARA TODOS elevada, solo llegan a la fase del servidor si son seguras: sin Secure, "para todos" ignoraria
      la carpeta y el acceso directo elegidos y se quedaria con los valores por defecto sin avisar.
      RIESGO con la directiva AlwaysInstallElevated (HKLM y HKCU, desactivada por defecto en Windows): con ella cualquier
      usuario instala CUALQUIER .msi con permisos de SYSTEM (es una escalada de privilegios conocida de esa directiva, no de
      este paquete), y Secure le deja ademas elegir la carpeta donde el servidor escribe. Se ACEPTA porque no anade nada
      nuevo: (1) el contenido lo fija el MSI (5 archivos de Tesela; el usuario no puede cambiarlo), (2) con esa directiva el
      usuario ya podria instalar su propio MSI como SYSTEM, (3) RemoveFolder solo quita carpetas VACIAS y (4) la carpeta se
      compara con una lista de sitios protegidos solo para dar un aviso, no como barrera. Quien tenga esa directiva activa ya
      tiene un problema mayor que este instalador. Sin Secure, "para todos" con interfaz no funcionaria, y la
      alternativa (una accion personalizada que releyera el valor) esta prohibida por la regla de no llevar codigo.
      msi-validate.ps1 exige exactamente estas dos (y las de MajorUpgrade) en SecureCustomProperties.
    -->
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />

    <!--
      Instalaciones previas (la deteccion que usan el bloqueo del cambio de ambito y la carpeta de las actualizaciones). Los
      valores los escriben los propios componentes (InstallFolder y DesktopShortcut, en HKMU: HKCU para una instalacion por
      usuario, HKLM para una para todos). Son busquedas de registro (AppSearch, tambien en la fase del servidor), sin accion
      personalizada. Se buscan LAS DOS raices a proposito: AppSearch corre ANTES de que la interfaz decida el ambito, asi que
      no puede usar HKMU. La v0.1.4 ya escribia HKCU\Software\Tesela\InstallFolder: se reconoce y se actualiza encima.
    -->
    <Property Id="TESELA_PREV_USER">
      <RegistrySearch Id="PrevUserFolder" Root="HKCU" Key="Software\Tesela" Name="InstallFolder" Type="raw" />
    </Property>
    <Property Id="TESELA_PREV_MACHINE">
      <RegistrySearch Id="PrevMachineFolder" Root="HKLM" Key="Software\Tesela" Name="InstallFolder" Type="raw" />
    </Property>
    <Property Id="TESELA_PREV_DESKTOP_USER">
      <RegistrySearch Id="PrevUserDesktop" Root="HKCU" Key="Software\Tesela" Name="DesktopShortcut" Type="raw" />
    </Property>
    <Property Id="TESELA_PREV_DESKTOP_MACHINE">
      <RegistrySearch Id="PrevMachineDesktop" Root="HKLM" Key="Software\Tesela" Name="DesktopShortcut" Type="raw" />
    </Property>
    <!--
       A remembered folder WITHOUT tesela.exe does not count (for example, a folder deleted without uninstalling).
       This checks file existence, NOT Windows Installer product registration. A registry value plus an orphaned executable
       still counts; see the installer README recovery procedure before changing orphaned metadata. Es otra busqueda de
      registro con un FileSearch, sin codigo; AppSearch las procesa por orden alfabetico de la propiedad, y _EXE va despues de
      su carpeta. Si el archivo no esta, las acciones TeselaStale* de abajo vacian TESELA_PREV_USER / TESELA_PREV_MACHINE y la
      clave se ignora (no bloquea el cambio de ambito ni fija una carpeta que ya no existe).
    -->
    <Property Id="TESELA_PREV_USER_EXE">
      <RegistrySearch Id="PrevUserExe" Root="HKCU" Key="Software\Tesela" Name="InstallFolder" Type="directory">
        <FileSearch Name="tesela.exe" />
      </RegistrySearch>
    </Property>
    <Property Id="TESELA_PREV_MACHINE_EXE">
      <RegistrySearch Id="PrevMachineExe" Root="HKLM" Key="Software\Tesela" Name="InstallFolder" Type="directory">
        <FileSearch Name="tesela.exe" />
      </RegistrySearch>
    </Property>

    <!--
      Arbol de carpetas. INSTALLFOLDER cuelga de TARGETDIR y su ruta REAL la fijan las acciones de tipo 51 de abajo (la propiedad
      INSTALLFOLDER, que Windows Installer usa como ruta del Directory al calcular los costes) segun el ambito:
      [LocalAppDataFolder]Programs\Tesela\ (por usuario) o %ProgramW6432%\Tesela\ (para todos), o la carpeta de la instalacion
      anterior, o la que pida INSTALLFOLDER= / la ventana. El nombre "Tesela" solo vale si nada la fija. (Se usa el tipo 51 y no el
      35 porque ICE12 exige el 35 DESPUES de CostFinalize y la carpeta tiene que estar fijada ANTES.)
      ProgramMenuFolder y DesktopFolder dependen de ALLUSERS (menu y escritorio del usuario, o los comunes del equipo).
    -->
    <Directory Id="INSTALLFOLDER" Name="Tesela" />
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Carpeta de instalacion: por ambito, la de la instalacion anterior (una actualizacion se queda donde estaba; la
         linea de comandos NO la cambia, igual que en la v0.1.4: hay que desinstalar e instalar de nuevo) y, si nada la fija,
         la de por defecto. Todo en las DOS secuencias (la interfaz y el servidor): al ser idempotentes, el servidor de una
         instalacion para todos repite el calculo con el valor seguro que le llega y no lo cambia. -->
    <!-- OJO: en el contexto POR USUARIO (el de partida: MSIINSTALLPERUSER=1) Windows Installer REDIRIGE [ProgramFilesFolder] y
         [ProgramFiles64Folder] a %LOCALAPPDATA%\Programs\ (comprobado con una sesion del propio paquete). Por eso la carpeta de
         "para todos" y las carpetas protegidas NO salen de esas propiedades sino de las variables de entorno del sistema
         (%ProgramW6432%, %SystemRoot%), que no dependen del contexto.
         Carpetas protegidas: se compara por PREFIJO y SIN barra final (`C:\Program Files`, `C:\WINDOWS`), de modo que cubre
         `C:\Program Files`, `C:\Program Files\X`, `C:\Program Files (x86)\X` y `C:\Program Files (Arm)\X` (ARM64), sin barra
         final y sin distinguir mayusculas. Coste aceptado: una carpeta cuyo NOMBRE empiece igual (`C:\Program Files2`,
         `C:\Windows.old`) tambien se trata como protegida. Es un aviso, no una barrera (ver README). -->
    <CustomAction Id="TeselaStaleUser" Property="TESELA_PREV_USER" Value="" Execute="immediate" />
    <CustomAction Id="TeselaStaleMachine" Property="TESELA_PREV_MACHINE" Value="" Execute="immediate" />
    <CustomAction Id="TeselaSetDefaultUser" Property="TESELA_DEFAULT_USER" Value="[LocalAppDataFolder]Programs\Tesela\" Execute="immediate" />
    <CustomAction Id="TeselaSetDefaultMachine" Property="TESELA_DEFAULT_MACHINE" Value="[%ProgramW6432]\Tesela\" Execute="immediate" />
    <CustomAction Id="TeselaSetProtected64" Property="TESELA_PF64" Value="[%ProgramW6432]" Execute="immediate" />
    <CustomAction Id="TeselaSetProtectedWin" Property="TESELA_WIN" Value="[%SystemRoot]" Execute="immediate" />
    <CustomAction Id="TeselaFolderPrevUser" Property="INSTALLFOLDER" Value="[TESELA_PREV_USER]" Execute="immediate" />
    <CustomAction Id="TeselaFolderPrevMachine" Property="INSTALLFOLDER" Value="[TESELA_PREV_MACHINE]" Execute="immediate" />
    <CustomAction Id="TeselaFolderDefaultUser" Property="INSTALLFOLDER" Value="[TESELA_DEFAULT_USER]" Execute="immediate" />
    <CustomAction Id="TeselaFolderDefaultMachine" Property="INSTALLFOLDER" Value="[TESELA_DEFAULT_MACHINE]" Execute="immediate" />
    <!-- Acceso directo del escritorio: se recuerda. Si DESKTOPSHORTCUT no viene fijado (vacio) y la instalacion anterior lo
         tenia (y existe: tesela.exe en su carpeta), se mantiene. Un valor explicito (DESKTOPSHORTCUT=0, o la casilla de la
         interfaz) manda. Solo cuando NO hay interfaz completa (UILevel < 5) en la secuencia del servidor: con interfaz, la casilla
         ya parte del valor recordado y el servidor NO debe volver a ponerlo si el usuario la desmarco. -->
    <CustomAction Id="TeselaRememberDesktop" Property="DESKTOPSHORTCUT" Value="1" Execute="immediate" />

    <!-- Desde cuando se aplican (tras AppSearch, que rellena TESELA_PREV_*, y antes de LaunchConditions y de CostInitialize).
         Primero se descartan las claves sin producto. -->
    <InstallUISequence>
      <Custom Action="TeselaStaleUser" Sequence="51" Condition="TESELA_PREV_USER&lt;&gt;&quot;&quot; AND TESELA_PREV_USER_EXE=&quot;&quot;" />
      <Custom Action="TeselaStaleMachine" Sequence="52" Condition="TESELA_PREV_MACHINE&lt;&gt;&quot;&quot; AND TESELA_PREV_MACHINE_EXE=&quot;&quot;" />
      <Custom Action="TeselaSetDefaultUser" Sequence="53" />
      <Custom Action="TeselaSetDefaultMachine" Sequence="54" />
      <Custom Action="TeselaSetProtected64" Sequence="55" />
      <Custom Action="TeselaSetProtectedWin" Sequence="56" />
      <Custom Action="TeselaFolderPrevUser" Sequence="57" Condition="TESELA_PREV_USER&lt;&gt;&quot;&quot; AND NOT (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderPrevMachine" Sequence="58" Condition="TESELA_PREV_MACHINE&lt;&gt;&quot;&quot; AND (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderDefaultUser" Sequence="59" Condition="INSTALLFOLDER=&quot;&quot; AND NOT (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderDefaultMachine" Sequence="60" Condition="INSTALLFOLDER=&quot;&quot; AND (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaRememberDesktop" Sequence="61" Condition="DESKTOPSHORTCUT=&quot;&quot; AND ((TESELA_PREV_DESKTOP_USER=&quot;1&quot; AND TESELA_PREV_USER&lt;&gt;&quot;&quot;) OR (TESELA_PREV_DESKTOP_MACHINE=&quot;1&quot; AND TESELA_PREV_MACHINE&lt;&gt;&quot;&quot;))" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="TeselaStaleUser" Sequence="51" Condition="TESELA_PREV_USER&lt;&gt;&quot;&quot; AND TESELA_PREV_USER_EXE=&quot;&quot;" />
      <Custom Action="TeselaStaleMachine" Sequence="52" Condition="TESELA_PREV_MACHINE&lt;&gt;&quot;&quot; AND TESELA_PREV_MACHINE_EXE=&quot;&quot;" />
      <Custom Action="TeselaSetDefaultUser" Sequence="53" />
      <Custom Action="TeselaSetDefaultMachine" Sequence="54" />
      <Custom Action="TeselaSetProtected64" Sequence="55" />
      <Custom Action="TeselaSetProtectedWin" Sequence="56" />
      <Custom Action="TeselaFolderPrevUser" Sequence="57" Condition="TESELA_PREV_USER&lt;&gt;&quot;&quot; AND NOT (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderPrevMachine" Sequence="58" Condition="TESELA_PREV_MACHINE&lt;&gt;&quot;&quot; AND (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderDefaultUser" Sequence="59" Condition="INSTALLFOLDER=&quot;&quot; AND NOT (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaFolderDefaultMachine" Sequence="60" Condition="INSTALLFOLDER=&quot;&quot; AND (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER))" />
      <Custom Action="TeselaRememberDesktop" Sequence="61" Condition="UILevel&lt;5 AND DESKTOPSHORTCUT=&quot;&quot; AND ((TESELA_PREV_DESKTOP_USER=&quot;1&quot; AND TESELA_PREV_USER&lt;&gt;&quot;&quot;) OR (TESELA_PREV_DESKTOP_MACHINE=&quot;1&quot; AND TESELA_PREV_MACHINE&lt;&gt;&quot;&quot;))" />
    </InstallExecuteSequence>

    <!--
      Condiciones de lanzamiento (ademas de la del bloqueo de versiones anteriores que anade MajorUpgrade). Dejan pasar siempre
      una reparacion o desinstalacion (Installed) y TODA instalacion con la interfaz completa (UILevel 5): con interfaz son las
      propias ventanas las que avisan y no dejan seguir (la ventana de ambito y la de carpeta), y estas condiciones se evaluan
      ANTES de que el usuario elija. Sin interfaz (/qn, /qb) no hay nadie a quien avisar y mandan ellas.
      "Instalacion para todos" = ALLUSERS=1, o ALLUSERS=2 con MSIINSTALLPERUSER vacio.
      * Cambio de ambito: de por usuario a para todos se bloquea siempre que ESTE usuario tenga la suya. De para todos a por
        usuario se bloquea solo si ESTE usuario no tiene ya una por usuario: la suya manda y puede actualizarla aunque otra
        cuenta haya instalado para todos.
      * La carpeta protegida (Archivos de programa, Windows) se rechaza en "solo para mi" para QUIEN SEA, administrador incluido:
        no se usa la propiedad Privileged (segun la documentacion de Windows Installer vale lo mismo que AdminUser: el USUARIO es
        administrador, no que el proceso este elevado, y un administrador sin elevar tampoco puede escribir en Archivos de
        programa). Ademas, en "solo para mi" una carpeta de Archivos de programa es un error de eleccion: lo suyo es "para todos".
      * Formato de la ruta: tiene que ser completa con unidad (C:\...) y sin "/", "..", "?" ni ruta de red (\\): sin ello el aviso de
        carpeta protegida se esquivaria con `C:/Program Files/X`, `C:\x\..\Program Files`, `?\C:\...` con prefijo de ruta larga o un recurso administrativo de red (C$). Los
        nombres cortos 8.3 (`C:\PROGRA~1`) NO se detectan sin codigo; es un aviso, no una barrera.
      Los mensajes van en espanol e ingles juntos (no hay forma de elegir idioma aqui sin acciones personalizadas).
    -->
    <Launch
      Condition="Installed OR UILevel&gt;=5 OR NOT (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER)) OR TESELA_PREV_USER=&quot;&quot;"
      Message="Tesela ya está instalada solo para tu usuario: desinstálala antes de instalarla para todos los usuarios. / Tesela is already installed for your user only: uninstall it before installing it for all users." />
    <Launch
      Condition="Installed OR UILevel&gt;=5 OR (ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER)) OR TESELA_PREV_MACHINE=&quot;&quot; OR TESELA_PREV_USER&lt;&gt;&quot;&quot;"
      Message="Tesela ya está instalada para todos los usuarios: actualízala con ALLUSERS=1 o desinstálala antes de cambiar de ámbito. / Tesela is already installed for all users: update it with ALLUSERS=1 or uninstall it before changing scope." />
    <Launch
      Condition="Installed OR UILevel&gt;=5 OR ALLUSERS=1 OR (ALLUSERS=2 AND NOT MSIINSTALLPERUSER) OR NOT (INSTALLFOLDER~&lt;&lt;TESELA_PF64 OR INSTALLFOLDER~&lt;&lt;TESELA_WIN)"
      Message="INSTALLFOLDER está en un sitio protegido y esta instalación es solo para tu usuario: elige otra carpeta o usa ALLUSERS=1. / INSTALLFOLDER is in a protected location and this install is for your user only: choose another folder or use ALLUSERS=1." />
    <Launch
      Condition="Installed OR UILevel&gt;=5 OR (INSTALLFOLDER&gt;&lt;&quot;:\&quot; AND NOT (INSTALLFOLDER&lt;&lt;&quot;\\&quot; OR INSTALLFOLDER&gt;&lt;&quot;/&quot; OR INSTALLFOLDER&gt;&lt;&quot;..&quot; OR INSTALLFOLDER&gt;&lt;&quot;?&quot;))"
      Message="INSTALLFOLDER tiene que ser una ruta completa con unidad (C:\Carpeta), sin /, .., ? ni ruta de red. / INSTALLFOLDER must be a full path with a drive letter (C:\Folder), without /, .., ? or a network path." />

    <!--
      Un componente por archivo. Cada componente lleva como KeyPath un valor de HKMU (HKCU en la instalacion por usuario, HKLM
      en la de todos): ICE38 (los archivos del perfil no pueden ser su propio KeyPath) y la mezcla de datos por usuario y por
      equipo (ICE57) se evitan, y Windows Installer los quita al desinstalar. Con archivo Y valor de registro WiX no puede
      generar el GUID del componente, asi que van FIJOS (no cambiarlos: Windows Installer identifica el componente por su
      GUID entre versiones; son los mismos que en la v0.1.4).
    -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="TeselaExe" Guid="B684DA7F-4E1F-49DD-9ED7-A7D2C72A1B22">
        <File Id="TeselaExe" Source="$(SourceDir)\tesela.exe" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="tesela.exe" Type="integer" Value="1" KeyPath="yes" />
        <!-- La carpeta se RECUERDA aqui y se recupera con la busqueda de registro de arriba (en las actualizaciones, las
             reparaciones y la desinstalacion): sin ella, al desinstalar o actualizar sin repetir INSTALLFOLDER Windows
             Installer buscaria la carpeta por defecto y los archivos de la personalizada quedarian huerfanos. -->
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" />
        <!-- Quita la carpeta SOLO si queda vacia (si el usuario dejo algo suyo dentro, se respeta). La carpeta padre
             (Programs, o la que sea) no se toca: ya no cuelga de una carpeta conocida del perfil. -->
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
      <Component Id="TeselaScanExe" Guid="F6AC4BAC-3E83-4784-ACA7-50ED49A1D3D9">
        <File Id="TeselaScanExe" Source="$(SourceDir)\tesela-scan.exe" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="tesela-scan.exe" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="LicenseMit" Guid="1B50C86F-50F5-4EEF-B97B-BE62D82BBB9D">
        <File Id="LicenseMit" Source="$(SourceDir)\LICENSE-MIT" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="LICENSE-MIT" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="LicenseApache" Guid="100B9CE0-2501-4884-8A2D-FE074CF71F06">
        <File Id="LicenseApache" Source="$(SourceDir)\LICENSE-APACHE" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="LICENSE-APACHE" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyNotices" Guid="0FFBF222-BD3C-4B09-A7A1-97CA3D105F13">
        <File Id="ThirdPartyNotices" Source="$(SourceDir)\THIRD-PARTY-NOTICES.md" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="THIRD-PARTY-NOTICES.md" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Acceso directo del menu Inicio (directamente en Programas, sin carpeta propia): el del usuario o el comun del equipo
         segun el ambito. GUID FIJO como el de los demas componentes (no cambiarlo). -->
    <ComponentGroup Id="StartMenu" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="089416B7-8B88-4F2D-9636-96931BE9FCC0">
        <Shortcut
          Id="StartMenuShortcut"
          Name="Tesela"
          Description="Visual disk space analyzer and cleaner"
          Target="[INSTALLFOLDER]tesela.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="TeselaIcon.ico" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Acceso directo del escritorio (OPCIONAL, desmarcado por defecto: casilla de la interfaz o DESKTOPSHORTCUT=1). El
         valor de registro DesktopShortcut="1" es su KeyPath Y la marca que busca TESELA_PREV_DESKTOP_*: asi se recuerda en
         las actualizaciones (el instalador nuevo lo ve y lo vuelve a crear) y desaparece con el componente al desinstalar. -->
    <ComponentGroup Id="DesktopShortcutGroup" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="5C2D6C0B-7C3E-4B6B-9B7A-3E0D1A9F6D41" Condition="DESKTOPSHORTCUT=&quot;1&quot;">
        <Shortcut
          Id="DesktopShortcut"
          Name="Tesela"
          Description="Visual disk space analyzer and cleaner"
          Target="[INSTALLFOLDER]tesela.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="TeselaIcon.ico" />
        <RegistryValue Root="HKMU" Key="Software\Tesela" Name="DesktopShortcut" Type="string" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Tesela" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="StartMenu" />
      <ComponentGroupRef Id="DesktopShortcutGroup" />
    </Feature>

    <UIRef Id="TeselaUI" />
  </Package>
</Wix>
