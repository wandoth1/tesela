<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuentes de NuGet para instalar WiX. scripts/install-wix.ps1 lo pasa a dotnet con el parametro configfile: con el, dotnet
  IGNORA el resto de la configuracion de NuGet de la maquina o del usuario. Solo nuget.org, nada mas.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
